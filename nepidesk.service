[Unit]
Description=nepidesk.de — htmforge Dashboard
After=network.target

[Service]
Type=simple
User=moritz
WorkingDirectory=/opt/nepidesk
ExecStart=/opt/nepidesk/venv/bin/gunicorn app:app -w 2 -b 127.0.0.1:5100
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
